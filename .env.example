# Public values are embedded in the client. Never put a service-role key here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
# Leave off until the exact recovery redirect and native build are prepared for controlled testing.
EXPO_PUBLIC_PASSWORD_RECOVERY_ENABLED=false
# Android emulator uses http://10.0.2.2:54321; a phone uses your local host LAN IP.
# Keep blank until the matching development/staging/production Sentry project exists.
EXPO_PUBLIC_SENTRY_DSN=
# Build-only values; SENTRY_AUTH_TOKEN belongs in secret CI/EAS storage, not this file.
SENTRY_ORG=
SENTRY_PROJECT=
